# ==============================================================================
# Xeroww Platform Environment Configuration (.env.example)
# Copy to .env and adjust variables for your target deployment environment.
# ==============================================================================

# Application Metadata
APP_NAME=Xeroww API
APP_VERSION=0.9.0
APP_ENV=development

# Database Configuration
# Local SQLite (default for zero-config local dev):
DATABASE_URL=sqlite:///./xeroww.db
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg://xeroww:xeroww_secret@localhost:5432/xeroww_db
AUTO_CREATE_TABLES=true

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
CACHE_QUOTE_TTL=15
CACHE_OHLC_TTL=300
CACHE_BREADTH_TTL=60
RATE_LIMIT_UNAUTH_RPM=60
RATE_LIMIT_AUTH_RPM=180

# Security & Authentication
# Generate a strong 32+ character key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=dev_insecure_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# Market Data Provider ("yahoo" in V0.6; "kafka", "spark" in V1.0)
MARKET_DATA_PROVIDER=yahoo
OHLC_DEFAULT_PERIOD=1mo
OHLC_DEFAULT_INTERVAL=1d

# Initial Virtual Capital for New User Portfolios
DEFAULT_PORTFOLIO_CASH=1000000.0

# Docker Compose Exposed Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
# Optional writable directory for yfinance timezone and cookie caches.
# Defaults to the operating system temp directory under xeroww-yfinance.
# YFINANCE_CACHE_DIR=/tmp/xeroww-yfinance
