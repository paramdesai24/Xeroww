# Xeroww API — Environment Variables
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# Database (Optional for V0 — No runtime DB required)
# Uncomment and configure for V0.5+ when PostgreSQL is introduced.
# DATABASE_URL=postgresql://user:password@localhost:5432/xeroww

# CORS — Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data Provider
MARKET_DATA_PROVIDER=yahoo  # Options: yahoo | (future: kafka)
