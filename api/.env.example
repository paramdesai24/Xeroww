# Xeroww API — Environment Variables
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_VERSION=0.8.0

# Database (Optional for V0 — No runtime DB required)
# Uncomment and configure for V0.5+ when PostgreSQL is introduced.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/xeroww
AUTO_CREATE_TABLES=true

# CORS — Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data Provider
MARKET_DATA_PROVIDER=yahoo  # Options: yahoo | (future: kafka)
# Optional writable directory for yfinance timezone and cookie caches.
# Defaults to the operating system temp directory under xeroww-yfinance.
# YFINANCE_CACHE_DIR=/tmp/xeroww-yfinance

# Optional Kafka ingestion pipeline, independent from the API read path
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_MARKET_DATA_TOPIC=market-data
KAFKA_CONSUMER_GROUP=xeroww-market-data
KAFKA_PRODUCER_CLIENT_ID=xeroww-market-data-producer
KAFKA_CONSUMER_CLIENT_ID=xeroww-market-data-consumer
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_DELIVERY_TIMEOUT_MS=30000
KAFKA_RETRIES=3
KAFKA_POLL_TIMEOUT_SECONDS=1.0
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=3
MARKET_DATA_WORKER_INTERVAL_SECONDS=60
MARKET_DATA_WORKER_SYMBOLS=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS

# Optional bounded Snowflake analytical feature loader
# These values are read only when the explicit loader command is invoked.
SNOWFLAKE_ENABLED=false
# SNOWFLAKE_ACCOUNT=organization-account
# SNOWFLAKE_USER=xeroww_loader
# Choose exactly one authentication method:
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_private_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_WAREHOUSE=XEROWW_INGESTION
# SNOWFLAKE_DATABASE=XEROWW
SNOWFLAKE_SCHEMA=ANALYTICS
# SNOWFLAKE_ROLE=XEROWW_LOADER
SNOWFLAKE_FEATURE_TABLE=FACT_MARKET_FEATURES
SNOWFLAKE_BATCH_TABLE=FEATURE_INGESTION_BATCHES
SNOWFLAKE_FEATURE_VIEW=LATEST_MARKET_FEATURES
